<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/panelCard"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_panel_card"
        android:orientation="vertical">

        <!-- 原生拖拽条：下拉关闭面板 -->
        <LinearLayout
            android:id="@+id/panelHandle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_handle_pill" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="快速记录"
                android:textColor="#666666"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/panelClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="关闭面板"
                android:padding="10dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="#14000000" />

        <WebView
            android:id="@+id/panelWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
